# Скопируйте файл и подставьте свои значения:
#   cp .env.example .env

# HTTP
PORT=9000
HOST=localhost

# Строка подключения к PostgreSQL
POSTGRESQL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# JWT. Обязательно замените на случайные значения
SECRET_JWT=CHANGE_ME
JWT_TTL=1
SECRET_REFRESH=CHANGE_ME
REFRESH_TTL=10
